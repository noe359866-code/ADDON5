# Puerto del addon. En Render/Railway lo inyecta la plataforma.
PORT=7000

# URL pública del servicio. En Render se deduce del Host de la petición, así
# que normalmente NO hace falta. Solo sirve para forzar un dominio concreto en
# los enlaces del proxy (/proxy?u=…).
#PUBLIC_BASE_URL=https://tu-servicio.onrender.com

# --- Fuentes -------------------------------------------------------------
# Catálogo de Gnula (WordPress). Si el dominio rota, cambia solo esta línea.
GNULA_BASE_URL=https://www2.gnula.one
# Sitio hermano de Gnula para series (misma plantilla de reproductores).
SERIES_BASE_URL=https://ver.verteleseriesonline.com
# Metadatos IMDb → título/año (público, sin clave).
CINEMETA_BASE_URL=https://v3-cinemeta.strem.io

# --- Proxy de video ------------------------------------------------------
# auto   → proxy solo cuando el CDN exige Referer (recomendado)
# always → todo pasa por el addon (gasta ancho de banda del servidor)
# never  → se devuelve la URL directa + behaviorHints.proxyHeaders
STREAM_PROXY=auto

# --- Tiempos (Stremio abandona las peticiones lentas) --------------------
HANDLER_DEADLINE_MS=15000
FETCH_TIMEOUT_MS=7000
# Reproductores que se intentan abrir por petición y en paralelo.
MAX_RESOLVE_PER_REQUEST=6
RESOLVE_CONCURRENCY=3
# Saltos al seguir un agregador (cuevana → iframe → video).
MAX_RESOLVE_HOPS=3

# --- Caché (en memoria) --------------------------------------------------
# Ficha de Gnula (lista de reproductores).
CACHE_TTL_SECONDS=900
# URL de video ya resuelta (los CDN firman enlaces que caducan).
MEDIA_CACHE_TTL_SECONDS=240

# --- Extras --------------------------------------------------------------
# Log detallado de scraping por consola.
DEBUG=false
# Nombre visible del addon en Stremio.
ADDON_NAME=Gnula Streams
# User-Agent con el que se piden las páginas de los reproductores.
#USER_AGENT=
