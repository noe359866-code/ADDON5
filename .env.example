# Puerto del addon (Stremio suele usar 7000 en desarrollo; en Render/Railway lo define la plataforma)
PORT=7000

# URL pública del addon. En Render se rellena sola con RENDER_EXTERNAL_URL.
# Sin ella, el proxy /sub/… queda desactivado y se devuelven los enlaces
# originales de los sitios (que Stremio Web puede bloquear por CORS y que a
# menudo son .zip, un formato que Stremio no reproduce).
#PUBLIC_BASE_URL=https://tu-servicio.onrender.com

# Secreto estable (32+ caracteres) para firmar los enlaces /sub/{token}.srt.
# Si no se define se genera uno aleatorio al arrancar: los subtítulos que ya
# estuvieran cargados en Stremio dejarán de valer tras un reinicio.
#SUBTITLE_TOKEN_SECRET=

# --- Proveedores con API oficial (opcionales pero recomendados) ---
# SubDL:    https://subdl.com/panel/api       (gratis, 2.000 req/día)
# SubSource: https://subsource.net -> My Profile -> API Key
# Son el respaldo cuando el scraping falla (Cloudflare, HTML cambiado…).
SUBDL_API_KEY=
SUBSOURCE_API_KEY=

# Idiomas preferidos / a pedir a las APIs (orden de prioridad: español, inglés).
# El resto de idiomas encontrados también se devuelve, ordenado detrás.
SUBTITLE_LANGUAGES=ES,EN
# true = SOLO los idiomas de arriba; false (defecto) = todos, pero ES/EN primero
SUBTITLE_LANGUAGES_ONLY=false

# Presupuesto TOTAL de una petición de Stremio. Stremio abandona las
# peticiones lentas y eso se ve como "no hay subtítulos": si el scraping no
# termina a tiempo, el addon responde con lo que ya tenga.
HANDLER_DEADLINE_MS=9000
# Timeout de cada petición HTTP a un sitio de subtítulos.
PROVIDER_TIMEOUT_MS=5000
# Fichas de detalle que abre cada proveedor (más = más lento).
MAX_DETAIL_FETCHES=4
# TTL de la caché. Solo se cachean listas CON resultados.
CACHE_TTL_SECONDS=21600

# Proxy de descargas: descomprime el .zip, convierte a UTF-8/SRT y sirve el
# texto con CORS desde tu dominio. Desactívalo solo para depurar.
#SUBTITLE_PROXY=true
# Validez de los enlaces /sub/ (7 días por defecto)
#SUBTITLE_TOKEN_TTL_SECONDS=604800
# Timeout y tamaño máximo al descargar el archivo original
#PROXY_TIMEOUT_MS=20000
#PROXY_MAX_BYTES=20971520

# --- Anime ---
# Stremio envía "kitsu:1234", "mal:1234"… Para buscar en sitios que solo
# entienden IMDb se resuelve el tt… equivalente con el índice público de Fribb.
#ANIME_MAPPING_ENABLED=true
#ANIME_MAPPING_URLS=https://raw.githubusercontent.com/Fribb/anime-lists/master/anime-list-mini.json
#ANIME_MAPPING_TIMEOUT_MS=15000

# Espejos opcionales si un dominio cae/cambia (valores por defecto en el código)
#YTS_SUBS_BASE_URLS=https://yifysubtitles.ch,https://www.yts-subs.com
#SUBSCENE_BASE_URL=https://sub-scene.com
#INDEXSUBTITLE_BASE_URL=https://indexsubtitle.cc
