{
  "name": "hitzbidaia",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "HitzBidaia / Viaje de Palabras: aventura de lectura progresiva en euskera y castellano",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
